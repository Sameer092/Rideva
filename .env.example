# ---- Mobile app (read at build time via app.config / expo-constants) --------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_MAPS_IOS_KEY=your-ios-maps-key
GOOGLE_MAPS_ANDROID_KEY=your-android-maps-key

# ---- Supabase backend (edge function secrets) -------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=your-google-secret
APPLE_OAUTH_CLIENT_ID=com.rideva.app
APPLE_OAUTH_SECRET=your-apple-secret

# ---- Payments (Stripe-ready, optional) --------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
