{
  "expo": {
    "name": "Rideva",
    "slug": "rideva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rideva",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rideva.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rideva uses your location to find nearby drivers and track your ride.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Drivers share live location during active trips so passengers can track arrival.",
        "UIBackgroundModes": ["location", "remote-notification"]
      },
      "config": {
        "googleMapsApiKey": "GOOGLE_MAPS_IOS_KEY"
      }
    },
    "android": {
      "package": "com.rideva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_ANDROID_KEY"
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Rideva uses your location to match you with drivers and provide live tracking."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5B5BD6"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://YOUR_PROJECT.supabase.co",
      "supabaseAnonKey": "YOUR_ANON_KEY",
      "googleOauthClientId": "YOUR_GOOGLE_WEB_CLIENT_ID",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
